<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
        Persistence Unit de TEST utilisant H2 In-Memory.
        Exercice 8 : permet de lancer des tests JPA sans PostgreSQL.
        Le schéma est créé au démarrage et détruit à la fin (create-drop).
    -->
    <persistence-unit name="MasterAnnonceTest" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Enregistrement explicite des entités -->
        <class>org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.model.Annonce</class>
        <class>org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.model.User</class>
        <class>org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.model.Category</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- H2 In-Memory : la BD existe tant que la JVM tourne -->
            <property name="javax.persistence.jdbc.url"
                      value="jdbc:h2:mem:masterannonce_test;DB_CLOSE_DELAY=-1;MODE=PostgreSQL"/>
            <property name="javax.persistence.jdbc.driver"
                      value="org.h2.Driver"/>
            <property name="javax.persistence.jdbc.user"
                      value="sa"/>
            <property name="javax.persistence.jdbc.password"
                      value=""/>

            <!-- Dialecte H2 compatible Hibernate 5.6 -->
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.H2Dialect"/>

            <!-- create-drop : schéma recréé à chaque démarrage de l'EMF -->
            <property name="hibernate.hbm2ddl.auto"
                      value="create-drop"/>

            <!-- Désactiver le SQL verbeux pour les tests -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>

</persistence>
