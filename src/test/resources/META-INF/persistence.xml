<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
        Unité de persistance pour les TESTS (H2 in-memory).
        Exercice 8 – BDD H2 en mode "In-Memory"
        - create-drop : le schéma est créé au démarrage et supprimé à la fin
        - Permet des tests isolés et reproductibles sans PostgreSQL
    -->
    <persistence-unit name="masterannonce-test">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Déclaration explicite des entités pour les tests -->
        <class>org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.model.Annonce</class>
        <class>org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.model.User</class>
        <class>org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.model.Category</class>

        <properties>
            <!-- H2 In-Memory -->
            <property name="javax.persistence.jdbc.url"
                      value="jdbc:h2:mem:masterannonce_test;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL"/>
            <property name="javax.persistence.jdbc.driver"
                      value="org.h2.Driver"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>

            <!-- Dialecte H2 -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>

            <!-- create-drop : fresh schema pour chaque suite de tests -->
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>

            <!-- Logs SQL visibles en test pour faciliter le débogage -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

    <!-- Alias "default" pour les tests utilisant JPAUtil sans modification -->
    <persistence-unit name="default">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.model.Annonce</class>
        <class>org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.model.User</class>
        <class>org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.model.Category</class>

        <properties>
            <property name="javax.persistence.jdbc.url"
                      value="jdbc:h2:mem:masterannonce_test;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL"/>
            <property name="javax.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
