<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Logging structuré SLF4J + Logback -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Fichier de log rotatif -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/masterannonce.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/masterannonce.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- API – niveau INFO -->
    <logger name="org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.api" level="INFO"/>
    <!-- Service – niveau DEBUG pour le dev -->
    <logger name="org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.service" level="DEBUG"/>
    <!-- Sécurité – niveau WARN en prod -->
    <logger name="org.univ_paris8.iut.montreuil.qdev.tp2025.gr07jeuquizz.tps6.security" level="DEBUG"/>
    <!-- Hibernate : ne montrer que les warnings -->
    <logger name="org.hibernate" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
