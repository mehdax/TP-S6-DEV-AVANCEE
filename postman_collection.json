{
  "info": {
    "name": "MasterAnnonce API – TP3",
    "description": "Collection Postman pour tester l'API REST MasterAnnonce (TP3 Dev Avancé)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/TP-S6/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔵 Exercice 1 – Hello World",
      "item": [
        {
          "name": "GET /helloWorld",
          "request": { "method": "GET", "url": "{{baseUrl}}/helloWorld" }
        },
        {
          "name": "GET /params?q=bonjour",
          "request": { "method": "GET", "url": "{{baseUrl}}/params?q=bonjour" }
        },
        {
          "name": "GET /params/monValeur",
          "request": { "method": "GET", "url": "{{baseUrl}}/params/monValeur" }
        }
      ]
    },
    {
      "name": "🔐 Authentification",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "POST /auth/login (→ sauvegarde le token)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const json = pm.response.json();", "if (json.token) pm.collectionVariables.set('token', json.token);"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/login – Mauvais credentials (→ 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"inexistant\",\n  \"password\": \"mauvais\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "📋 Annonces – Public",
      "item": [
        {
          "name": "GET /annonces (liste paginée)",
          "request": { "method": "GET", "url": "{{baseUrl}}/annonces?page=0&pageSize=10" }
        },
        {
          "name": "GET /annonces?q=Paris (recherche)",
          "request": { "method": "GET", "url": "{{baseUrl}}/annonces?q=Paris" }
        },
        {
          "name": "GET /annonces/1 (détail)",
          "request": { "method": "GET", "url": "{{baseUrl}}/annonces/1" }
        },
        {
          "name": "GET /annonces/9999 (→ 404)",
          "request": { "method": "GET", "url": "{{baseUrl}}/annonces/9999" }
        }
      ]
    },
    {
      "name": "✏️ Annonces – Protégés (auth requise)",
      "item": [
        {
          "name": "POST /annonces – Créer (→ 201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Appartement Paris Centre\",\n  \"description\": \"Magnifique appartement lumineux au coeur de Paris\",\n  \"adress\": \"75001 Paris\",\n  \"mail\": \"alice@test.com\",\n  \"categoryId\": 1\n}"
            },
            "url": "{{baseUrl}}/annonces"
          }
        },
        {
          "name": "POST /annonces – Sans token (→ 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Test\"\n}" },
            "url": "{{baseUrl}}/annonces"
          }
        },
        {
          "name": "POST /annonces – Données invalides (→ 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"description\": \"court\"\n}" },
            "url": "{{baseUrl}}/annonces"
          }
        },
        {
          "name": "PUT /annonces/1 – Mise à jour complète",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Titre modifié\",\n  \"description\": \"Description modifiée suffisamment longue\",\n  \"adress\": \"75002 Paris\",\n  \"mail\": \"alice@test.com\",\n  \"categoryId\": 1\n}"
            },
            "url": "{{baseUrl}}/annonces/1"
          }
        },
        {
          "name": "PATCH /annonces/1 – Mise à jour partielle",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Titre partiel uniquement\"\n}" },
            "url": "{{baseUrl}}/annonces/1"
          }
        },
        {
          "name": "POST /annonces/1/publish – Publier",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/annonces/1/publish"
          }
        },
        {
          "name": "POST /annonces/1/archive – Archiver",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/annonces/1/archive"
          }
        },
        {
          "name": "DELETE /annonces/1 – Supprimer (doit être ARCHIVED)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/annonces/1"
          }
        },
        {
          "name": "DELETE /annonces/2 – Non archivée (→ 409)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/annonces/2"
          }
        }
      ]
    }
  ]
}
